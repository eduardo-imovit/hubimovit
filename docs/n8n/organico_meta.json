    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const REDE = 'instagram';\nconst CONTA = '17841402369467127';\nconst diaOntem = $now.setZone('America/Sao_Paulo').minus({ days: 1 }).toISODate();\nconst linhas = [];\n\nconst achar = (teste) => $input.all().find(i => teste(i.json || {}))?.json;\nconst perfil = achar(j => 'followers_count' in j);\nconst insights = achar(j => Array.isArray(j.data) && j.data.some(m => m.name === 'reach' || m.name === 'views' || m.name === 'total_interactions'));\nconst novos = achar(j => Array.isArray(j.data) && j.data.some(m => m.name === 'follows_and_unfollows'));\n\nconst faltando = [];\nif (!perfil) faltando.push('Perfil Instagram');\nif (!insights) faltando.push('Insights ontem');\nif (!novos) faltando.push('Seguidores novos (ontem)');\nif (faltando.length) throw new Error('Sem resposta de: ' + faltando.join(', ') + '. Confira conexoes e credenciais.');\n\nconst nomes = {\n  reach: 'alcance',\n  views: 'visualizacoes',\n  total_interactions: 'interacoes',\n  profile_views: 'visitas_perfil',\n  website_clicks: 'cliques_site',\n};\n\nfor (const m of insights.data) {\n  const metrica = nomes[m.name];\n  if (!metrica) continue;\n  const valor = m.total_value?.value;\n  if (valor === null || valor === undefined) continue;\n  linhas.push({ data: diaOntem, rede: REDE, conta: CONTA, metrica, valor });\n}\n\nif (perfil.followers_count !== null && perfil.followers_count !== undefined) {\n  linhas.push({ data: diaOntem, rede: REDE, conta: CONTA, metrica: 'seguidores', valor: perfil.followers_count });\n}\n\nconst m = novos.data.find(x => x.name === 'follows_and_unfollows');\nconst follow = m?.total_value?.breakdowns?.[0]?.results?.find(r => String(r.dimension_values?.[0]).toUpperCase() === 'FOLLOWER');\nif (follow && follow.value !== null && follow.value !== undefined) {\n  linhas.push({ data: diaOntem, rede: REDE, conta: CONTA, metrica: 'seguidores_novos', valor: follow.value });\n}\n\nreturn [{ json: { p_diario: linhas } }];"
      },
      "id": "b1f3c8d0-2005-4005-9005-000000000005",
